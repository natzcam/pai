{
  "name": "pai-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:worklet": "node scripts/pack-worklet.mjs",
    "build:addons": "node scripts/link-addons.mjs",
    "build:bare": "npm run build:worklet && npm run build:addons",
    "start": "npm run build:bare && expo start",
    "android": "npm run build:bare && expo run:android",
    "android:release": "npm run build:bare && expo run:android --variant release",
    "ios": "npm run build:bare && expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e:android": "node scripts/e2e-android.mjs",
    "eas-build-post-install": "(cd ../.. && npm ci) && (cd ../worklet && npm ci) && npm run build:bare"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-local-authentication": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bare-kit": "^0.16.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "bare-bundle": "^1.11.0",
    "bare-link": "^3.3.0",
    "bare-pack": "^2.2.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.tsx"
    ]
  }
}
