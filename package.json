{
  "name": "pai",
  "version": "0.0.0",
  "description": "Peer-to-peer agent orchestration across machines and owners, over A2A and Holepunch",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pai": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/ship-types.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "a2a",
    "agents",
    "orchestration",
    "workflows",
    "p2p",
    "holepunch",
    "hyperswarm",
    "protomux"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natzcam/pai.git"
  },
  "homepage": "https://github.com/natzcam/pai#readme",
  "bugs": {
    "url": "https://github.com/natzcam/pai/issues"
  },
  "dependencies": {
    "autobase": "^7.28.2",
    "blind-pairing": "^2.3.1",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.16.1",
    "hyperbee": "^2.27.3",
    "hyperdht": "^6.34.1",
    "hyperswarm": "^4.17.2",
    "protomux": "^3.13.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "express": "5.3.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
